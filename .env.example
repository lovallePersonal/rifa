# Copy this file to .env.local and fill in your Supabase project values.
# .env.local is gitignored; this .env.example is committed as documentation.

# Supabase project URL (Project Settings -> API -> Project URL)
VITE_SUPABASE_URL=

# Supabase anon/public key (Project Settings -> API -> Project API keys -> anon public)
VITE_SUPABASE_ANON_KEY=

# App version shown in the footer. Set by the deploy pipeline; 'dev' locally.
VITE_APP_VERSION=dev
